# Product data API (Rainforest API) - required for live retailer listings.
# Without it the app prints a clear message and falls back to data/fixtures/.
PRODUCT_API_KEY=

# QuickCommerce API (BlinkIt/Zepto/Swiggy/BigBasket/DMart/JioMart/Minutes/
# Amazon/Nykaa/Myntra/Flipkart) - optional, additional to Rainforest/Amazon.
# Without it, adapters/quickcommerce.py logs and sits out; every other
# provider (Amazon/Rainforest) is unaffected.
QUICKCOMMERCE_API_KEY=
# QUICKCOMMERCE_BASE_URL=https://api.quickcommerceapi.com

# Groq (brief parser) - required for LLM-based rule extraction.
# Without it, core/parser.py falls back to a regex parser automatically.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Supabase sync (storage layer) & Frontend Auth.
SUPABASE_URL=
SUPABASE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional overrides
# LEDGER_DB_PATH=data/ledger.db
# CACHE_DIR=data/raw
