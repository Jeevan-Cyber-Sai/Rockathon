# Product data API (Rainforest API) - required for live retailer listings.
# Without it the app prints a clear message and falls back to data/fixtures/.
PRODUCT_API_KEY=

# OpenRouter (brief parser) - required for LLM-based rule extraction.
# Without it, core/parser.py falls back to a regex parser automatically.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Supabase sync (storage layer). Both must be set or sync stays disabled.
SUPABASE_URL=
SUPABASE_KEY=

# Optional overrides
# LEDGER_DB_PATH=data/ledger.db
# CACHE_DIR=data/raw
